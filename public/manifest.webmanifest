{
  "id": "./",
  "name": "RETRON",
  "short_name": "RETRON",
  "description": "DOS·SFC·GBA·GBC·N64 고전 게임을 브라우저에서. 게임과 세이브는 내 구글 드라이브에",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#07070c",
  "theme_color": "#07070c",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "screenshots/landing-narrow.jpg", "sizes": "824x1830", "type": "image/jpeg", "form_factor": "narrow", "label": "RETRON 첫 화면" },
    { "src": "screenshots/landing-wide.jpg", "sizes": "1920x1200", "type": "image/jpeg", "form_factor": "wide", "label": "RETRON 첫 화면" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["application/zip", "application/x-zip-compressed", "application/octet-stream", ".zip", ".sfc", ".smc", ".fig", ".swc", ".gba", ".gb", ".gbc", ".z64", ".n64", ".v64"]
        }
      ]
    }
  }
}
